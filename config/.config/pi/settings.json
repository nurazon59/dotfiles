{
  "lastChangelogVersion": "1.1.0",
  "theme": "dark",
  "compaction": {
    "enabled": false
  },
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "high",
  "tuiMode": "regular",
  "quietStartup": true,
  "modelThinkingLevels": {
    "openai-codex/gpt-6-luna": "high"
  },
  "treeFilterMode": "all",
  "packages": [
    "npm:pi-memory@0.4.2"
  ],
  "extensions": [
    "-builtin:mcp",
    "-builtin:llama.cpp",
    "-builtin:codemode",
    "-builtin:tool-search"
  ],
  "hideThinkingBlock": true
}